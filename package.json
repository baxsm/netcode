{
  "name": "netcode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "npm run build:wasm:web && npm run build:wasm:node",
    "build:wasm:web": "wasm-pack build core --target web --out-dir pkg-web --release",
    "build:wasm:node": "wasm-pack build core --target nodejs --out-dir pkg-node --release",
    "test:core": "cargo test --manifest-path core/Cargo.toml",
    "test:determinism": "vitest run tests/determinism",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:core && npm run test:unit && npm run test:determinism && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  }
}
